{
  "name": "qm9-similitud",
  "image": "mcr.microsoft.com/devcontainers/python:3.10-bullseye",

  "postCreateCommand": "pip install --upgrade pip && pip install git+https://github.com/samoturk/mol2vec && pip install -r requirements.txt",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter",
        "ms-toolsai.jupyter-renderers"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "jupyter.notebookFileRoot": "${workspaceFolder}"
      }
    }
  },

  "forwardPorts": [8888],

  "mounts": [
    "source=${localWorkspaceFolder},target=/workspaces/proyecto,type=bind"
  ],

  "remoteUser": "vscode"
}

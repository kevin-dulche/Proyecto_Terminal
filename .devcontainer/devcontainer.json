{
  "name": "qm9-similitud",
  "image": "mcr.microsoft.com/devcontainers/anaconda",

  // Esto pide la GPU de forma dinámica: si existe la usa, si no, usa el CPU.
  "hostRequirements": {
    "gpu": "optional",
    "cpus": 4,
    "memory": "16gb",
    "storage": "32gb"
  },

  "postCreateCommand": "python setup.py",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter",
        "ms-toolsai.jupyter-renderers"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/opt/conda/envs/qm9-similitud/bin/python",
        "jupyter.notebookFileRoot": "${workspaceFolder}"
      }
    }
  },

  "forwardPorts": [8888]
}